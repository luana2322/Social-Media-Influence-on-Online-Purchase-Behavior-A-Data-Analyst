### 3. Job Queue Repository (SKIP LOCKED)
```java
public interface JobQueueRepository extends JpaRepository<JobQueue, Long> {
    @Query(value = "SELECT * FROM job_queue " +
           "WHERE status = 'pending' OR (status = 'processing' AND locked_at < NOW() - INTERVAL '10 minutes') " +
           "ORDER BY created_at ASC LIMIT 1 FOR UPDATE SKIP LOCKED", nativeQuery = true)
    Optional<JobQueue> findPendingJobWithSkipLocked();
}
```

### 4. Job Worker (Polling, Fault Tolerant)
```java
@Component
public class JobWorker {
    private static final String WORKER_ID = UUID.randomUUID().toString();
    private static final int POLL_MS = 5000;
    private static final int CHUNK_SIZE = 1000;

    @Autowired private JobQueueRepository jobQueueRepository;
    @Autowired private DatasetStreamingService streamingService;

    @PostConstruct
    public void start() {
        new Thread(() -> {
            while (true) {
                try { processNextJob(); Thread.sleep(POLL_MS); }
                catch (Exception e) { e.printStackTrace(); }
            }
        }).start();
    }

    private void processNextJob() {
        jobQueueRepository.findPendingJobWithSkipLocked().ifPresent(job -> {
            try {
                job.setStatus("processing");
                job.setLockedBy(WORKER_ID);
                job.setLockedAt(LocalDateTime.now());
                jobQueueRepository.saveAndFlush(job);

                JsonNode payload = new ObjectMapper().readTree(job.getPayload());
                int chunks = streamingService.streamAndProcess(
                    payload.get("datasetPath").asText(), job.getJobId(), CHUNK_SIZE
                );

                job.setStatus("done");
                jobQueueRepository.save(job);
            } catch (Exception e) {
                handleFailedJob(job, e);
            }
        });
    }

    private void handleFailedJob(JobQueue job, Exception e) {
        int retries = job.getRetries() + 1;
        job.setRetries(retries);
        if (retries >= job.getMaxRetries()) job.setStatus("failed");
        else { job.setStatus("pending"); job.setLockedBy(null); job.setLockedAt(null); }
        jobQueueRepository.save(job);
    }
}
```

### 5. Streaming CSV Service (No Memory Overload)
```java
@Service
public class DatasetStreamingService {
    @Autowired private PredictionService predictionService;

    public int streamAndProcess(String path, Long jobId, int chunkSize) throws IOException {
        int chunkCount = 0;
        List<Map<String, Object>> chunk = new ArrayList<>(chunkSize);
        BufferedReader br = new BufferedReader(new FileReader(path));
        String line; boolean isHeader = true; String[] headers = null;

        while ((line = br.readLine()) != null) {
            if (isHeader) { headers = line.split(","); isHeader = false; continue; }
            String[] values = line.split(",");
            Map<String, Object> record = new HashMap<>();
            for (int i = 0; i < headers.length; i++) record.put(headers[i], values[i]);
            chunk.add(record);
            if (chunk.size() == chunkSize) {
                predictionService.processChunk(chunk, jobId);
                chunk.clear(); chunkCount++;
            }
        }
        if (!chunk.isEmpty()) { predictionService.processChunk(chunk, jobId); chunkCount++; }
        return chunkCount;
    }
}
```

