## 🗄️ Database Schema
### Job Queue Table
```sql
CREATE TABLE job_queue (
    id SERIAL PRIMARY KEY,
    job_id INT,
    status VARCHAR(20) DEFAULT 'pending',  -- pending, processing, done, failed
    retries INT DEFAULT 0,
    max_retries INT DEFAULT 3,
    locked_by VARCHAR(100),
    locked_at TIMESTAMP,
    payload JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX idx_job_queue_status ON job_queue(status);
```

### Prediction Results Table (with model versioning)
```sql
CREATE TABLE prediction_results (
    id SERIAL PRIMARY KEY,
    job_id INT,
    record_id VARCHAR(100),
    probability FLOAT,
    segment VARCHAR(20),
    model_version VARCHAR(50),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE INDEX idx_pred_results_job_id ON prediction_results(job_id);
```

## ⚙️ Spring Boot Implementation
### 1. Job Producer (Insert Jobs to Queue)
```java
@Service
public class JobProducer {
    @Autowired private JobQueueRepository jobQueueRepository;
    @Autowired private PredictionJobRepository predictionJobRepository;

    public Long createJob(String datasetPath) {
        PredictionJob job = new PredictionJob();
        job.setStatus("pending");
        job.setDatasetPath(datasetPath);
        job.setCreatedAt(LocalDateTime.now());
        predictionJobRepository.save(job);

        JobQueue queueItem = new JobQueue();
        queueItem.setJobId(job.getId());
        queueItem.setPayload(String.format("{\"datasetPath\": \"%s\"}", datasetPath));
        queueItem.setCreatedAt(LocalDateTime.now());
        jobQueueRepository.save(queueItem);

        return job.getId();
    }
}
```

